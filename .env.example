OPENAI_API_KEY=
DISCORD_TOKEN=
OPENAI_MODEL=gpt-4.1-mini
MEMORY_MODEL=gpt-4.1-mini
# 메시지 시작에서 인식할 호출어. 쉼표 구분, 1~20개, 각각 최대 32자입니다.
CALL_PREFIXES=히나야
# false: DM에서도 멘션 또는 히나야 호출이 필요합니다.
DM_ALWAYS_REPLY=false
# 공개 채널에서 같은 사용자가 나눈 대화를 DM에서만 추가 참고합니다.
PUBLIC_SERVER_MEMORY_IN_DM=true
DATABASE_PATH=data/hina.sqlite3
# 비우면 패키지 내 기본 프롬프트를 사용합니다. UTF-8 파일 경로를 지정할 수 있습니다.
CHARACTER_PROMPT_PATH=
# 비우면 초대된 모든 서버에서 사용합니다. 쉼표로 구분한 서버 ID입니다.
ALLOWED_GUILD_IDS=
COOLDOWN_SECONDS=5
MAX_CONCURRENT_REQUESTS=3
MAX_OUTPUT_TOKENS=1000
SUMMARY_EVERY=8
HISTORY_TURNS=12

# 최근 채널 문맥 본문 합계 문자 수 상한. 0이면 전달하지 않습니다.
CHANNEL_CONTEXT_CHARS=6000

# 앱 소유자 외에 /emoji 관리를 허용할 Discord 사용자 ID (쉼표 구분)
BOT_ADMIN_IDS=

# 이 사용자와의 DM에서만 선생님 관계 적용. 비우면 모두 일반 관계. 관리 권한과 별개.
SPECIAL_DM_USER_ID=
